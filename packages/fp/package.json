{
  "name": "@deessejs/fp",
  "version": "5.0.0",
  "description": "Functional Programming Utilities for TypeScript",
  "homepage": "https://fp.deessejs.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/deessejs/fp.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "keywords": [
    "typescript",
    "functional-programming",
    "result",
    "maybe",
    "try",
    "unit",
    "pipe",
    "flow",
    "error-handling",
    "async",
    "monorepo",
    "deessejs",
    "fp"
  ],
  "author": "Nesalia Inc. <hello@nesalia.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "bugs": {
    "url": "https://github.com/deessejs/fp/issues",
    "email": "support@deessejs.com"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
