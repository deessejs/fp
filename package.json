{
  "name": "complete-package-template",
  "version": "1.0.0",
  "description": "TypeScript package template",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "husky",
    " changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm test && changeset publish"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@changesets/cli": "3.0.0-next.5",
    "husky": "^9.1.7",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "turbo": "^2.9.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
